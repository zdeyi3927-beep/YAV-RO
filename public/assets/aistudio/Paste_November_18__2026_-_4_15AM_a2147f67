    Dim lastRow As Long, r As Long
    Dim daysLeft As Integer
    Dim resultRow As Long
    
    Set ws = ThisWorkbook.Worksheets("Sheet2")
    lastRow = ws.Cells(ws.Rows.count, 1).End(xlUp).row
    
    ' 创建结果工作表
    Dim resultWs As Worksheet
    On Error Resume Next
    Application.DisplayAlerts = False
    Set resultWs = ThisWorkbook.Worksheets("25天内到期")
    If Not resultWs Is Nothing Then
        resultWs.Delete
    End If
    Application.DisplayAlerts = True
    On Error GoTo 0
    
    Set resultWs = Worksheets.Add(After:=Worksheets(Worksheets.count))
    resultWs.Name = "25天内到期"
    
    ' 创建标题
    With resultWs
        .Cells(1, 1).Value = "序号"
        .Cells(1, 2).Value = "工号"
        .Cells(1, 3).Value = "柬埔寨名"
        .Cells(1, 4).Value = "英文名"
        .Cells(1, 5).Value = "性别"
        .Cells(1, 6).Value = "开始日期"
        .Cells(1, 7).Value = "结束日期"
        .Cells(1, 8).Value = "剩余天数"
        .Rows(1).Font.Bold = True
        .Rows(1).Interior.Color = RGB(240, 240, 240)
    End With
    
    resultRow = 2
    
    ' 遍历查找25天内到期的合同
    For r = 2 To lastRow
        If ws.Cells(r, 10).Value <> "不通过" Then
            If IsDate(ws.Cells(r, 9).Value) Then
                daysLeft = DateDiff("d", Date, CDate(ws.Cells(r, 9).Value))
                
                If daysLeft >= 0 And daysLeft <= 25 Then
                    resultWs.Cells(resultRow, 1).Value = resultRow - 1
                    resultWs.Cells(resultRow, 2).Value = ws.Cells(r, 1).Value
                    resultWs.Cells(resultRow, 3).Value = ws.Cells(r, 2).Value
                    resultWs.Cells(resultRow, 4).Value = ws.Cells(r, 3).Value
                    resultWs.Cells(resultRow, 5).Value = ws.Cells(r, 4).Value
                    resultWs.Cells(resultRow, 6).Value = ws.Cells(r, 8).Value
                    resultWs.Cells(resultRow, 7).Value = ws.Cells(r, 9).Value
                    resultWs.Cells(resultRow, 8).Value = daysLeft
                    
                    ' 根据剩余天数设置颜色
                    Select Case daysLeft
                        Case 0 To 7
                            resultWs.Rows(resultRow).Interior.Color = RGB(255, 200, 200)
                        Case 8 To 15
                            resultWs.Rows(resultRow).Interior.Color = RGB(255, 220, 220)
                        Case 16 To 25
                            resultWs.Rows(resultRow).Interior.Color = RGB(255, 240, 240)
                    End Select
                    
                    resultRow = resultRow + 1
                End If
            End If
        End If
    Next r
    
    If resultRow > 2 Then
        resultWs.Columns("A:H").AutoFit
        resultWs.Range("A1:H" & resultRow - 1).Borders.LineStyle = xlContinuous
        MsgBox "共找到 " & (resultRow - 2) & " 份25天内到期的合同。", vbInformation
    Else
        MsgBox "没有找到25天内到期的合同。", vbInformation
        Application.DisplayAlerts = False
        resultWs.Delete
        Application.DisplayAlerts = True
    End If
End Sub

' ============= 合同到期导出（按班组分Sheet） =============
Sub ExportExpiringContracts()
    Dim ws1 As Worksheet, ws2 As Worksheet
    Dim lastRow As Long, i As Long
    Dim wb As Workbook
    Dim ws As Worksheet
    Dim teamDict As Object
    Dim teamName As String
    Dim rowNum As Long
    Dim empId As String
    Dim foundRow As Range
    Dim currentYear As Integer, currentMonth As Integer
    Dim contractDate As Date
    Dim sheetCount As Integer
    Dim item As Variant
    Dim key As Variant
    Dim totalCount As Long
    
    ' 设置工作表
    Set ws1 = ThisWorkbook.Worksheets("Sheet1")
    Set ws2 = ThisWorkbook.Worksheets("Sheet2")
    
    ' 当前年月
    currentYear = year(Date)
    currentMonth = month(Date)
    
    ' 创建字典存储班组数据
    Set teamDict = CreateObject("Scripting.Dictionary")
    
    ' 遍历Sheet2
    lastRow = ws2.Cells(ws2.Rows.count, 1).End(xlUp).row
    
    For i = 2 To lastRow
        ' 只处理待审批的合同
        If ws2.Cells(i, 10).Value = "待审批" Then
            ' 检查结束日期
            If IsDate(ws2.Cells(i, 9).Value) Then
                contractDate = CDate(ws2.Cells(i, 9).Value)
                
                ' 检查是否当前月份
                If year(contractDate) = currentYear And month(contractDate) = currentMonth Then
                    ' 获取工号
                    empId = Trim(ws2.Cells(i, 1).Value)
                    
                    ' 查找班组
                    teamName = "其他"
                    Set foundRow = ws1.Columns(1).Find(empId, LookAt:=xlWhole)
                    If Not foundRow Is Nothing Then
                        If ws1.Cells(foundRow.row, 8).Value <> "" Then
                            teamName = ws1.Cells(foundRow.row, 8).Value
                        End If
                    End If
                    
                    ' 保存数据到字典
                    If Not teamDict.exists(teamName) Then
                        Set teamDict(teamName) = New Collection
                    End If
                    
                    ' 保存数据
                    Dim data(1 To 8) As Variant
                    data(1) = ws2.Cells(i, 1).Value  ' 工号
                    data(2) = ws2.Cells(i, 2).Value  ' 柬埔寨名
                    data(3) = ws2.Cells(i, 3).Value  ' 英文名
                    data(4) = teamName                ' 部门
                    data(5) = ws2.Cells(i, 5).Value  ' 入职日期
                    data(6) = ws2.Cells(i, 9).Value  ' 结束日期
                    data(7) = DateAdd("d", 60, CDate(ws2.Cells(i, 5).Value)) ' 转正日期
                    data(8) = DateAdd("d", 90, CDate(ws2.Cells(i, 9).Value)) ' 新合同到期日
                    
                    teamDict(teamName).Add data
                End If
            End If
        End If
    Next i
    
    ' 检查是否有数据
    If teamDict.count = 0 Then
        MsgBox "当前月份没有待审批的到期合同。", vbInformation
        Exit Sub
    End If
    
    ' 创建新工作簿
    Set wb = Workbooks.Add
    
    ' 删除多余的Sheet，只保留一个
    Application.DisplayAlerts = False
    Do While wb.Worksheets.count > 1
        wb.Worksheets(wb.Worksheets.count).Delete
    Loop
    Application.DisplayAlerts = True
    
    sheetCount = 0
    totalCount = 0
    
    ' 遍历每个班组
    For Each key In teamDict.keys
        sheetCount = sheetCount + 1
        
        ' 添加新Sheet
        If sheetCount > 1 Then
            wb.Worksheets.Add After:=wb.Worksheets(wb.Worksheets.count)
        End If
        
        Set ws = wb.Worksheets(sheetCount)
        
        ' Sheet名称（最多31个字符）
        If Len(key) > 31 Then
            ws.Name = Left(key, 28) & "..."
        Else
            ws.Name = key
        End If
        
        ' 写入标题
        With ws
            .Cells(1, 1).Value = "序号"
            .Cells(1, 2).Value = "工号"
            .Cells(1, 3).Value = "柬埔寨名"
            .Cells(1, 4).Value = "英文名"
            .Cells(1, 5).Value = "部门"
            .Cells(1, 6).Value = "入职日期"
            .Cells(1, 7).Value = "转正日期"
            .Cells(1, 8).Value = "续签日期"
            .Cells(1, 9).Value = "合同到期日"
            .Cells(1, 10).Value = "合同续签期限"
            .Cells(1, 11).Value = "本人确认续签"
            .Cells(1, 12).Value = "主管确认续签"
            .Cells(1, 13).Value = "备注"
            
            ' 标题格式
            .Rows(1).Font.Bold = True
            .Rows(1).Interior.Color = RGB(240, 240, 240)
            .Rows(1).HorizontalAlignment = xlCenter
        End With
        
        ' 写入数据
        rowNum = 2
        For Each item In teamDict(key)
            ws.Cells(rowNum, 1).Value = rowNum - 1
            ws.Cells(rowNum, 2).Value = item(1)
            ws.Cells(rowNum, 3).Value = item(2)
            ws.Cells(rowNum, 4).Value = item(3)
            ws.Cells(rowNum, 5).Value = item(4)
            ws.Cells(rowNum, 6).Value = item(5)
            ws.Cells(rowNum, 7).Value = item(7)
            ws.Cells(rowNum, 8).Value = item(6)
            ws.Cells(rowNum, 9).Value = item(8)
            ws.Cells(rowNum, 10).Value = "3个月"
            ws.Cells(rowNum, 11).Value = ""
            ws.Cells(rowNum, 12).Value = ""
            ws.Cells(rowNum, 13).Value = ""
            
            ' 设置日期格式
            ws.Range("F" & rowNum & ":I" & rowNum).NumberFormat = "yyyy-mm-dd"
            
            rowNum = rowNum + 1
            totalCount = totalCount + 1
        Next item
        
        ' 设置边框
        ws.Range("A1:M" & (rowNum - 1)).Borders.LineStyle = xlContinuous
        ws.Range("A1:M" & (rowNum - 1)).Borders.Weight = xlThin
        ws.Range("A1:M" & (rowNum - 1)).HorizontalAlignment = xlCenter
        ws.Range("A1:M" & (rowNum - 1)).VerticalAlignment = xlCenter
        
        ' 设置列宽
        ws.Columns("A").ColumnWidth = 8
        ws.Columns("B").ColumnWidth = 12
        ws.Columns("C").ColumnWidth = 20
        ws.Columns("D").ColumnWidth = 15
        ws.Columns("E").ColumnWidth = 15
        ws.Columns("F").ColumnWidth = 12
        ws.Columns("G").ColumnWidth = 12
        ws.Columns("H").ColumnWidth = 12
        ws.Columns("I").ColumnWidth = 12
        ws.Columns("J").ColumnWidth = 12
        ws.Columns("K").ColumnWidth = 15
        ws.Columns("L").ColumnWidth = 15
        ws.Columns("M").ColumnWidth = 15
        
        ' 设置打印格式
        With ws.PageSetup
            .Orientation = xlLandscape
            .PaperSize = xlPaperA4
            .FitToPagesWide = 1
            .Zoom = False
            .PrintTitleRows = "$1:$1"
        End With
        
        ' 添加本组合计
        ws.Cells(rowNum, 1).Value = "本组合计："
        ws.Cells(rowNum, 2).Value = (rowNum - 2) & " 人"
        ws.Cells(rowNum, 1).Font.Bold = True
        ws.Cells(rowNum, 2).Font.Bold = True
    Next key
    
    ' 添加汇总Sheet
    Set ws = wb.Worksheets.Add(Before:=wb.Worksheets(1))
    ws.Name = "汇总"
    
    With ws
        .Cells(1, 1).Value = "合同到期汇总表"
        .Cells(1, 1).Font.Bold = True
        .Cells(1, 1).Font.Size = 16
        .Range("A1:C1").Merge
        .Range("A1:C1").HorizontalAlignment = xlCenter
        
        .Cells(3, 1).Value = "导出月份："
        .Cells(3, 2).Value = currentYear & "年" & currentMonth & "月"
        .Cells(3, 1).Font.Bold = True
        
        .Cells(4, 1).Value = "导出时间："
        .Cells(4, 2).Value = Format(Now, "yyyy-mm-dd hh:mm:ss")
        .Cells(4, 1).Font.Bold = True
        
        .Cells(5, 1).Value = "总合同数："
        .Cells(5, 2).Value = totalCount & " 份"
        .Cells(5, 1).Font.Bold = True
        
        .Cells(7, 1).Value = "班组"
        .Cells(7, 2).Value = "人数"
        .Cells(7, 1).Font.Bold = True
        .Cells(7, 2).Font.Bold = True
        .Cells(7, 1).Interior.Color = RGB(240, 240, 240)
        .Cells(7, 2).Interior.Color = RGB(240, 240, 240)
        
        rowNum = 8
        For Each key In teamDict.keys
            .Cells(rowNum, 1).Value = key
            .Cells(rowNum, 2).Value = teamDict(key).count
            rowNum = rowNum + 1
        Next key
        
        .Cells(rowNum, 1).Value = "总计"
        .Cells(rowNum, 2).Value = totalCount
        .Cells(rowNum, 1).Font.Bold = True
        .Cells(rowNum, 2).Font.Bold = True
        
        .Columns("A:B").AutoFit
        .Range("A7:B" & rowNum).Borders.LineStyle = xlContinuous
    End With
    
    ' 激活第一个数据Sheet
    wb.Worksheets(2).Activate
    
    MsgBox "? 导出成功！" & vbCrLf & _
           "共 " & totalCount & " 份合同" & vbCrLf & _
           "按 " & teamDict.count & " 个班组分Sheet保存。", vbInformation
End Sub

' ============= 获取员工部门 =============
Private Function GetDepartment(empId As String) As String
    Dim ws As Worksheet
    Dim lastRow As Long, i As Long
    
    Set ws = ThisWorkbook.Worksheets("Sheet1")
    lastRow = ws.Cells(ws.Rows.count, 1).End(xlUp).row
    
    For i = 2 To lastRow
        If Trim(ws.Cells(i, 1).Value) = Trim(empId) Then
            GetDepartment = ws.Cells(i, 8).Value ' H列：班组
            Exit Function
        End If
    Next i
    
    GetDepartment = "未分配"
End Function

' ============= 添加快捷操作按钮 =============
Sub AddButtons()
    Dim ws As Worksheet
    Dim btn As Button
    
    Set ws = ThisWorkbook.Worksheets("Sheet2")
    
    ' 删除原有按钮
    On Error Resume Next
    For Each btn In ws.Buttons
        btn.Delete
    Next btn
    On Error GoTo 0
    
    ' 添加刷新按钮
    Set btn = ws.Buttons.Add(ws.Range("M1").Left, ws.Range("M1").Top, 100, 25)
    With btn
        .Caption = "刷新合同"
        .OnAction = "RefreshContracts"
        .Font.Size = 10
        .Font.Bold = True
    End With
    
    ' 添加审批通过按钮
    Set btn = ws.Buttons.Add(ws.Range("M2").Left, ws.Range("M2").Top, 100, 25)
    With btn
        .Caption = "审批通过"
        .OnAction = "ApproveContract"
        .Font.Size = 10
    End With
    
    ' 添加审批不通过按钮
    Set btn = ws.Buttons.Add(ws.Range("M3").Left, ws.Range("M3").Top, 100, 25)
    With btn
        .Caption = "审批不通过"
        .OnAction = "RejectContract"
        .Font.Size = 10
    End With
    
    ' 添加按月查询按钮
    Set btn = ws.Buttons.Add(ws.Range("M4").Left, ws.Range("M4").Top, 100, 25)
    With btn
        .Caption = "按月查询"
        .OnAction = "QueryExpiryByMonth"
        .Font.Size = 10
    End With
    
    ' 添加25天内到期按钮
    Set btn = ws.Buttons.Add(ws.Range("M5").Left, ws.Range("M5").Top, 100, 25)
    With btn
        .Caption = "25天内到期"
        .OnAction = "ShowExpiringContracts"
        .Font.Size = 10
    End With
    
    ' 添加导出本月合同按钮
    Set btn = ws.Buttons.Add(ws.Range("M6").Left, ws.Range("M6").Top, 100, 25)
    With btn
        .Caption = "导出本月合同"
        .OnAction = "ExportExpiringContracts"
        .Font.Size = 10
        .Font.Bold = True
    End With
    
    ' 设置按钮区域格式
    ws.Range("M1:M7").ColumnWidth = 15
    ws.Range("M1:M7").HorizontalAlignment = xlCenter
    ws.Range("M1:M7").VerticalAlignment = xlCenter
    ws.Range("M1:M7").Font.Bold = True
    ws.Range("M1").Value = "操作面板"
End Sub

' ============= 初始化系统 =============
Sub InitializeSystem()
    Call RefreshContracts
    Call AddButtons
    MsgBox "系统初始化完成！", vbInformation
End Sub


