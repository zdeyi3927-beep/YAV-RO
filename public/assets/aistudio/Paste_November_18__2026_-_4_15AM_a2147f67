' ============= 主程序：刷新合同数据 =============
Sub RefreshContracts()
    Dim wsSrc As Worksheet, wsDest As Worksheet
    Dim lastRow As Long, i As Long
    Dim destRow As Long
    Dim empId As String, entryDate As Date
    Dim contractCount As Long
    
    ' 设置工作表
    Set wsSrc = ThisWorkbook.Worksheets("Sheet1")
    Set wsDest = ThisWorkbook.Worksheets("Sheet2")
    
    ' 清空Sheet2原有数据（保留标题）
    wsDest.Cells.Clear
    Call CreateHeaders(wsDest)
    
    ' 获取Sheet1最后一行
    lastRow = wsSrc.Cells(wsSrc.Rows.count, 1).End(xlUp).row
    destRow = 2
    contractCount = 0
    
    ' 循环处理每个员工
    For i = 2 To lastRow
        empId = Trim(wsSrc.Cells(i, 1).Value) ' A列：工号
        
        If empId <> "" Then
            ' 检查入厂日期
            If IsDate(wsSrc.Cells(i, 10).Value) Then
                entryDate = CDate(wsSrc.Cells(i, 10).Value)
                
                ' 生成合同并写入Sheet2
                Call GenerateAndWriteContracts(wsSrc, wsDest, i, empId, entryDate, destRow, contractCount)
            End If
        End If
    Next i
    
    ' 格式化表格
    Call FormatContractSheet(wsDest, destRow - 1)
    
    ' 更新25天内到期合同计数
    Call UpdateExpiringCount(wsDest)
    
    MsgBox "合同数据刷新完成！共生成 " & contractCount & " 份合同", vbInformation
End Sub

' ============= 创建标题行 =============
Private Sub CreateHeaders(ws As Worksheet)
    With ws
        .Cells(1, 1).Value = "工号 "
        .Cells(1, 2).Value = "柬埔寨名 "
        .Cells(1, 3).Value = "英文名 "
        .Cells(1, 4).Value = "性别 "
        .Cells(1, 5).Value = "入厂日期 "
        .Cells(1, 6).Value = "入职年份 "
        .Cells(1, 7).Value = "合同类型"
        .Cells(1, 8).Value = "开始日期 "
        .Cells(1, 9).Value = "结束日期 "
        .Cells(1, 10).Value = "审批状态 "
        .Cells(1, 11).Value = "操作 "
        
        ' 设置标题行格式
        .Rows(1).Font.Bold = True
        .Rows(1).Interior.Color = RGB(240, 240, 240)
        .Rows(1).HorizontalAlignment = xlCenter
    End With
End Sub

' ============= 生成并写入合同 =============
Private Sub GenerateAndWriteContracts(wsSrc As Worksheet, wsDest As Worksheet, _
                                      srcRow As Long, empId As String, _
                                      startDate As Date, ByRef destRow As Long, _
                                      ByRef contractCount As Long)
    
    Dim currentStart As Date, currentEnd As Date
    Dim finalEnd As Date
    Dim contractType As String
    Dim contractIndex As Integer
    Dim khName As String, enName As String, gender As String
    Dim entryYear As Integer
    
    ' 获取员工基本信息
    khName = wsSrc.Cells(srcRow, 2).Value
    enName = wsSrc.Cells(srcRow, 3).Value
    gender = wsSrc.Cells(srcRow, 4).Value
    entryYear = year(startDate)
    
    finalEnd = CDate(TARGET_END)
    contractIndex = 0
    
    ' 第一段合同：试用期60天
    currentStart = startDate
    currentEnd = DateAdd("d", 60, currentStart)
    If currentEnd > finalEnd Then currentEnd = finalEnd
    
    ' 循环生成所有合同段
    Do While currentStart < finalEnd
        contractIndex = contractIndex + 1
        
        ' 确定合同类型
        If contractIndex = 1 Then
            contractType = "试用期(60天)"
        Else
            contractType = "续签合同(90天)"
        End If
        
        ' 写入Sheet2
        wsDest.Cells(destRow, 1).Value = empId
        wsDest.Cells(destRow, 2).Value = khName
        wsDest.Cells(destRow, 3).Value = enName
        wsDest.Cells(destRow, 4).Value = gender
        wsDest.Cells(destRow, 5).Value = startDate
        wsDest.Cells(destRow, 6).Value = entryYear
        wsDest.Cells(destRow, 7).Value = contractType
        wsDest.Cells(destRow, 8).Value = currentStart
        wsDest.Cells(destRow, 9).Value = currentEnd
        wsDest.Cells(destRow, 10).Value = "待审批"
        wsDest.Cells(destRow, 11).Value = "请选择操作"
        
        contractCount = contractCount + 1
        destRow = destRow + 1
        
        ' 准备下一段合同
        currentStart = DateAdd("d", 1, currentEnd)
        If currentStart >= finalEnd Then Exit Do
        currentEnd = DateAdd("d", 90, currentStart)
        If currentEnd > finalEnd Then currentEnd = finalEnd
    Loop
End Sub

' ============= 格式化合同表格 =============
Private Sub FormatContractSheet(ws As Worksheet, lastRow As Long)
    Dim r As Long
    Dim daysLeft As Integer
    
    ' 设置边框
    With ws.Range("A1:K" & lastRow)
        .Borders.LineStyle = xlContinuous
        .Borders.Weight = xlThin
        .HorizontalAlignment = xlCenter
        .VerticalAlignment = xlCenter
    End With
    
    ' 设置日期列格式
    ws.Range("E:E,H:I").NumberFormat = "yyyy-mm-dd"
    
    ' 根据审批状态和到期天数设置颜色
    For r = 2 To lastRow
        ' 根据审批状态设置颜色
        Select Case ws.Cells(r, 10).Value
            Case "通过"
                ws.Rows(r).Font.Color = RGB(0, 128, 0)
            Case "不通过"
                ws.Rows(r).Font.Color = RGB(255, 0, 0)
                ws.Rows(r).Font.Strikethrough = True
            Case "待审批"
                ws.Rows(r).Font.Color = RGB(255, 128, 0)
                ws.Rows(r).Font.Bold = True
        End Select
        
        ' 检查是否25天内到期
        If IsDate(ws.Cells(r, 9).Value) Then
            daysLeft = DateDiff("d", Date, CDate(ws.Cells(r, 9).Value))
            If daysLeft >= 0 And daysLeft <= 25 Then
                ' 根据剩余天数设置不同深浅的红色背景
                Select Case daysLeft
                    Case 0 To 7
                        ws.Rows(r).Interior.Color = RGB(255, 200, 200)
                    Case 8 To 15
                        ws.Rows(r).Interior.Color = RGB(255, 220, 220)
                    Case 16 To 25
                        ws.Rows(r).Interior.Color = RGB(255, 240, 240)
                End Select
                
                ' 在操作列添加提示
                ws.Cells(r, 11).Value = "?? " & daysLeft & "天后到期"
            End If
        End If
    Next r
    
    ' 自动调整列宽
    ws.Columns("A:K").AutoFit
    ' 设置操作列稍宽一些
    ws.Columns("K").ColumnWidth = 15
End Sub

' ============= 更新25天内到期合同计数 =============
Private Sub UpdateExpiringCount(ws As Worksheet)
    Dim lastRow As Long, r As Long
    Dim daysLeft As Integer
    Dim count As Integer
    
    lastRow = ws.Cells(ws.Rows.count, 1).End(xlUp).row
    count = 0
    
    For r = 2 To lastRow
        If ws.Cells(r, 10).Value <> "不通过" Then
            If IsDate(ws.Cells(r, 9).Value) Then
                daysLeft = DateDiff("d", Date, CDate(ws.Cells(r, 9).Value))
                If daysLeft >= 0 And daysLeft <= 25 Then
                    count = count + 1
                End If
            End If
        End If
    Next r
    
    ' 在表格上方显示计数
    ws.Range("A1").Value = "合同续签审批 (25天内到期: " & count & "份)"
End Sub

' ============= 审批通过 =============
Sub ApproveContract()
    Dim ws As Worksheet
    Dim r As Long
    Dim empId As String
    Dim currentEnd As Date, newStart As Date, newEnd As Date
    Dim lastRow As Long
    Dim answer As VbMsgBoxResult
    
    Set ws = ThisWorkbook.Worksheets("Sheet2")
    r = ActiveCell.row
    
    ' 检查是否选中有效行
    If r < 2 Then
        MsgBox "请选中一条合同记录！", vbExclamation
        Exit Sub
    End If
    
    empId = Trim(ws.Cells(r, 1).Value)
    If empId = "" Then
        MsgBox "请选中有效的合同记录！", vbExclamation
        Exit Sub
    End If
    
    ' 检查是否为待审批状态
    If ws.Cells(r, 10).Value <> "待审批" Then
        MsgBox "只有待审批的合同可以进行此操作！", vbExclamation
        Exit Sub
    End If
    
    ' 确认操作
    answer = MsgBox("确定要通过这份合同吗？", vbYesNo + vbQuestion)
    If answer = vbNo Then Exit Sub
    
    ' 检查结束日期
    If Not IsDate(ws.Cells(r, 9).Value) Then
        MsgBox "结束日期格式错误！", vbCritical
        Exit Sub
    End If
    
    ' 更新当前合同状态
    ws.Cells(r, 10).Value = "通过"
    ws.Cells(r, 11).Value = "已通过"
    ws.Rows(r).Font.Color = RGB(0, 128, 0)
    ws.Rows(r).Font.Bold = False
    
    ' 生成新合同
    currentEnd = CDate(ws.Cells(r, 9).Value)
    
    If currentEnd < CDate(TARGET_END) Then
        newStart = DateAdd("d", 1, currentEnd)
        newEnd = DateAdd("d", 90, newStart)
        If newEnd > CDate(TARGET_END) Then newEnd = CDate(TARGET_END)
        
        lastRow = ws.Cells(ws.Rows.count, 1).End(xlUp).row + 1
        
        ' 复制员工信息并添加新合同
        ws.Cells(lastRow, 1).Value = ws.Cells(r, 1).Value
        ws.Cells(lastRow, 2).Value = ws.Cells(r, 2).Value
        ws.Cells(lastRow, 3).Value = ws.Cells(r, 3).Value
        ws.Cells(lastRow, 4).Value = ws.Cells(r, 4).Value
        ws.Cells(lastRow, 5).Value = ws.Cells(r, 5).Value
        ws.Cells(lastRow, 6).Value = ws.Cells(r, 6).Value
        ws.Cells(lastRow, 7).Value = "续签合同(90天)"
        ws.Cells(lastRow, 8).Value = newStart
        ws.Cells(lastRow, 9).Value = newEnd
        ws.Cells(lastRow, 10).Value = "待审批"
        ws.Cells(lastRow, 11).Value = "待审批"
        
        ' 格式化新行
        ws.Rows(lastRow).Font.Color = RGB(255, 128, 0)
        ws.Rows(lastRow).Font.Bold = True
    End If
    
    ' 重新格式化表格
    Call FormatContractSheet(ws, ws.Cells(ws.Rows.count, 1).End(xlUp).row)
    Call UpdateExpiringCount(ws)
    
    MsgBox "? 审批通过！已生成下一份合同。", vbInformation
End Sub

' ============= 审批不通过 =============
Sub RejectContract()
    Dim ws As Worksheet
    Dim r As Long
    Dim empId As String
    Dim answer As VbMsgBoxResult
    
    Set ws = ThisWorkbook.Worksheets("Sheet2")
    r = ActiveCell.row
    
    ' 检查是否选中有效行
    If r < 2 Then
        MsgBox "请选中一条合同记录！", vbExclamation
        Exit Sub
    End If
    
    empId = Trim(ws.Cells(r, 1).Value)
    If empId = "" Then
        MsgBox "请选中有效的合同记录！", vbExclamation
        Exit Sub
    End If
    
    ' 检查是否为待审批状态
    If ws.Cells(r, 10).Value <> "待审批" Then
        MsgBox "只有待审批的合同可以进行此操作！", vbExclamation
        Exit Sub
    End If
    
    ' 确认操作
    answer = MsgBox("确定不通过这份合同吗？员工将不再续签。", vbYesNo + vbQuestion + vbDefaultButton2)
    If answer = vbNo Then Exit Sub
    
    ' 更新状态
    ws.Cells(r, 10).Value = "不通过"
    ws.Cells(r, 11).Value = "不续签"
    ws.Rows(r).Font.Color = RGB(255, 0, 0)
    ws.Rows(r).Font.Strikethrough = True
    ws.Rows(r).Font.Bold = False
    
    ' 重新格式化表格
    Call FormatContractSheet(ws, ws.Cells(ws.Rows.count, 1).End(xlUp).row)
    Call UpdateExpiringCount(ws)
    
    MsgBox "? 已标记为不通过，员工不再续签。", vbInformation
End Sub

' ============= 按月份查询到期合同 =============
Sub QueryExpiryByMonth()
    Dim ws As Worksheet
    Dim monthYear As String
    Dim year As Integer, month As Integer
    Dim startDate As Date, endDate As Date
    Dim lastRow As Long, r As Long
    Dim resultRow As Long
    Dim found As Boolean
    
    Set ws = ThisWorkbook.Worksheets("Sheet2")
    
    ' 获取用户输入的月份
    monthYear = InputBox("请输入要查询的年月 (格式: YYYY-MM)" & vbCrLf & _
                         "例如: 2026-03", "按月查询")
    If monthYear = "" Then Exit Sub
    
    ' 解析年月
    On Error Resume Next
    year = CInt(Split(monthYear, "-")(0))
    month = CInt(Split(monthYear, "-")(1))
    On Error GoTo 0
    
    If year = 0 Or month = 0 Or month < 1 Or month > 12 Then
        MsgBox "输入格式错误！请使用 YYYY-MM 格式", vbExclamation
        Exit Sub
    End If
    
    ' 计算查询范围
    startDate = DateSerial(year, month, 1)
    endDate = DateSerial(year, month + 1, 0)
    
    ' 创建结果工作表
    Dim resultWs As Worksheet
    On Error Resume Next
    Application.DisplayAlerts = False
    Set resultWs = ThisWorkbook.Worksheets("到期查询结果")
    If Not resultWs Is Nothing Then
        resultWs.Delete
    End If
    Application.DisplayAlerts = True
    On Error GoTo 0
    
    Set resultWs = Worksheets.Add(After:=Worksheets(Worksheets.count))
    resultWs.Name = "到期查询结果"
    
    ' 创建标题
    With resultWs
        .Cells(1, 1).Value = "序号"
        .Cells(1, 2).Value = "工号"
        .Cells(1, 3).Value = "柬埔寨名"
        .Cells(1, 4).Value = "英文名"
        .Cells(1, 5).Value = "性别"
        .Cells(1, 6).Value = "开始日期"
        .Cells(1, 7).Value = "结束日期"
        .Cells(1, 8).Value = "剩余天数"
        .Rows(1).Font.Bold = True
        .Rows(1).Interior.Color = RGB(240, 240, 240)
    End With
    
    lastRow = ws.Cells(ws.Rows.count, 1).End(xlUp).row
    resultRow = 2
    found = False
    
    ' 遍历查找到期合同
    For r = 2 To lastRow
        If ws.Cells(r, 10).Value <> "不通过" Then
            If IsDate(ws.Cells(r, 9).Value) Then
                If CDate(ws.Cells(r, 9).Value) >= startDate And _
                   CDate(ws.Cells(r, 9).Value) <= endDate Then
                    
                    found = True
                    resultWs.Cells(resultRow, 1).Value = resultRow - 1
                    resultWs.Cells(resultRow, 2).Value = ws.Cells(r, 1).Value
                    resultWs.Cells(resultRow, 3).Value = ws.Cells(r, 2).Value
                    resultWs.Cells(resultRow, 4).Value = ws.Cells(r, 3).Value
                    resultWs.Cells(resultRow, 5).Value = ws.Cells(r, 4).Value
                    resultWs.Cells(resultRow, 6).Value = ws.Cells(r, 8).Value
                    resultWs.Cells(resultRow, 7).Value = ws.Cells(r, 9).Value
                    resultWs.Cells(resultRow, 8).Value = DateDiff("d", Date, CDate(ws.Cells(r, 9).Value))
                    
                    resultRow = resultRow + 1
                End If
            End If
        End If
    Next r
    
    If found Then
        resultWs.Columns("A:H").AutoFit
        resultWs.Range("A1:H" & resultRow - 1).Borders.LineStyle = xlContinuous
        MsgBox "查询完成！共找到 " & (resultRow - 2) & " 条到期合同记录。", vbInformation
    Else
        MsgBox "该月份没有找到到期合同。", vbInformation
        Application.DisplayAlerts = False
        resultWs.Delete
        Application.DisplayAlerts = True
    End If
End Sub

' ============= 显示25天内到期合同 =============
Sub ShowExpiringContracts()
